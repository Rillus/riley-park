// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id            String    @id @default(cuid())
  name          String
  repositoryUrl String    @unique @map("repository_url")
  defaultBranch String    @default("main") @map("default_branch")
  description   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  features      Feature[]

  @@map("projects")
}

model Feature {
  id            String         @id @default(cuid())
  projectId     String         @map("project_id")
  title         String
  description   String
  priority      String         @default("medium") // high, medium, low
  status        String         @default("planned") // planned, in_progress, completed, blocked
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowSteps WorkflowStep[]

  @@map("features")
}

model WorkflowStep {
  id          String    @id @default(cuid())
  featureId   String    @map("feature_id")
  stepType    String    @map("step_type") // spec, design, implement, review, test, submit
  stepOrder   Int       @map("step_order") // Order of the step in workflow (1-6)
  status      String    @default("pending") // pending, in_progress, completed, blocked
  agentId     String?   @map("agent_id") // Cursor agent ID
  output      String?   // Step output/documentation
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  feature     Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@map("workflow_steps")
}

model Notification {
  id          String   @id @default(cuid())
  type        String   // step_completed, step_failed, workflow_completed
  title       String
  message     String
  featureId   String?  @map("feature_id")
  stepId      String?  @map("step_id")
  agentId     String?  @map("agent_id")
  read        Boolean  @default(false)
  actionUrl   String?  @map("action_url")
  actionLabel String?  @map("action_label")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model WorkflowSettings {
  id              String   @id @default(cuid())
  autoTransition  Boolean  @default(false) @map("auto_transition")
  pollingInterval Int      @default(5000) @map("polling_interval") // milliseconds
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("workflow_settings")
}
